# 2. Lecture avec Pandas
df = pd.read_csv(io.StringIO(csv_data))

# 3. Préparation du code Python à écrire dans le futur fichier
code_python = "# Fichier auto-généré\n\nPROFILES_DB = {\n"

print("Début du traitement des profilés...")

for index, row in df.iterrows():
    nom = row['nom']
    famille = row['famille']
    masse = float(row['masse_kg_m'])
    h = float(row['h_mm'])
    b = float(row['b_mm'])
    tw = float(row['tw_mm'])
    tf = float(row['tf_mm'])
    r = float(row['r_mm'])
    
    print(f"Calcul de {nom}... ({index + 1}/{len(df)})")
    
    # Calculs simples
    hi = h - 2 * tf
    d = hi - 2 * r
    
    # Calculs MEF via sectionproperties
    geom = i_section(d=h, b=b, t_f=tf, t_w=tw, r=r, n_r=16)
    
    # Taille de maille adaptative (compromis vitesse/précision)
    taille_maille_max = (h * b) / 100
    geom.create_mesh(mesh_sizes=[taille_maille_max])
    
    sec = Section(geom)
    sec.calculate_geometric_properties()
    
    A = sec.get_area()
    ixx, iyy, _ = sec.get_ic()
    
    # Ajout du profilé dans le dictionnaire formaté
    code_python += f'    "{nom}": {{\n'
    code_python += f'        "famille": "{famille}",\n'
    code_python += f'        "masse_kg_m": {masse},\n'
    code_python += f'        "h_mm": {h},\n'
    code_python += f'        "b_mm": {b},\n'
    code_python += f'        "tw_mm": {tw},\n'
    code_python += f'        "tf_mm": {tf},\n'
    code_python += f'        "r_mm": {r},\n'
    code_python += f'        "hi_mm": {hi:.2f},\n'
    code_python += f'        "d_mm": {d:.2f},\n'
    code_python += f'        "A_mm2": {A:.2f},\n'
    code_python += f'        "Iy_mm4": {ixx:.2f},\n'
    code_python += f'        "Iz_mm4": {iyy:.2f}\n'
    code_python += f'    }},\n'

code_python += "}\n"

# 4. Écriture du résultat dans le fichier steel_profiles/data.py
import os
chemin_dossier = "steel_profiles"
if not os.path.exists(chemin_dossier):
    os.makedirs(chemin_dossier)

chemin_fichier = os.path.join(chemin_dossier, "data.py")
with open(chemin_fichier, "w", encoding="utf-8") as f:
    f.write(code_python)

print(f"\nTerminé ! Le fichier '{chemin_fichier}' a été généré avec succès.")